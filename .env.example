# Heard local development settings

APP_ENV=local
APP_PORT=8082
HEARD_BIND_ADDRESS=127.0.0.1
HEARD_API_PORT=8082
DATABASE_URL=postgres://heard:heard@localhost:5432/heard?sslmode=disable

# Browser-facing app URLs
PUBLIC_APP_URL=http://localhost:3010
WEB_BASE_URL=http://localhost:3010
ALLOWED_ORIGIN=http://localhost:3010

# qurl integration. Leave empty to disable QR asset generation.
QURL_BASE_URL=
HEARD_SEED_DEMO=true
WORKER_POLL_INTERVAL_MS=1500
WORKER_BATCH_SIZE=50

# Public write abuse controls. Forwarded addresses are ignored unless the
# immediate proxy belongs to one of these comma-separated CIDR networks.
PUBLIC_WRITE_RATE_LIMIT=30
PUBLIC_WRITE_RATE_WINDOW_SECONDS=60
TRUSTED_PROXY_CIDRS=

# Real Passage is the default even in local Docker so customer auth semantics match production.
PASSAGE_MODE=jwks
LOCAL_PASSAGE_SECRET=heard-local-only-secret
# The local adapter is test-only and must be explicitly opted into.
PASSAGE_BASE_URL=http://localhost:8081
PASSAGE_PUBLIC_URL=http://localhost:3020
PASSAGE_ISSUER=http://localhost:8081
PASSAGE_AUDIENCE=heard
PASSAGE_JWKS_CACHE_SECONDS=300
PASSAGE_CLIENT_ID=heard
PASSAGE_CALLBACK_URL=http://localhost:3010/api/v1/auth/callback

# Next.js proxies browser requests to this internal API origin.
API_INTERNAL_BASE_URL=http://localhost:8082
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
