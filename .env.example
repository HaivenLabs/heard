# Heard local development settings

APP_ENV=local
APP_PORT=8080
DATABASE_URL=postgres://heard:heard@localhost:5432/heard?sslmode=disable

# Browser-facing app URLs
PUBLIC_APP_URL=http://localhost:3010
WEB_BASE_URL=http://localhost:3010
ALLOWED_ORIGIN=http://localhost:3010

# qurl integration. Leave empty to disable QR asset generation.
QURL_BASE_URL=
HEARD_SEED_DEMO=true
WORKER_POLL_INTERVAL_MS=1500

# Local Passage-compatible identity adapter. It is rejected when APP_ENV=production.
PASSAGE_MODE=local
LOCAL_PASSAGE_SECRET=heard-local-only-secret
# Production: set PASSAGE_MODE=jwks and configure the Passage service contract.
PASSAGE_BASE_URL=http://localhost:8081
PASSAGE_ISSUER=http://localhost:8081
PASSAGE_AUDIENCE=heard
PASSAGE_JWKS_CACHE_SECONDS=300

# Next.js proxies browser requests to this internal API origin.
API_INTERNAL_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
